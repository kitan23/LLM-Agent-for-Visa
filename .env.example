# OPT-RAG environment configuration
# Copy this file to .env and fill in your values.

# ---- LLM Providers (at least one is required) ----
# RunPod (primary) - OpenAI-compatible serverless endpoint
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_MODEL_NAME=qwen/qwen2.5-1.5b-instruct

# OpenAI (fallback)
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

# ---- Vector Store ----
VECTOR_STORE_PATH=./vector_store

# ---- Langfuse (LLM observability, optional) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
